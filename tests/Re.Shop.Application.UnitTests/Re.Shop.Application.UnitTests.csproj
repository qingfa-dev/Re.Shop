<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Application.UnitTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.analyzers" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <!-- Application reaches inward only — no Infrastructure, Api or Contracts
       (spec §5.3 rule 2), so neither may this. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Re.Shop.Application/Re.Shop.Application.csproj" />
    <ProjectReference Include="../../src/Re.Shop.Domain/Re.Shop.Domain.csproj" />
    <ProjectReference Include="../../src/Re.Shop.SharedKernel/Re.Shop.SharedKernel.csproj" />
  </ItemGroup>
</Project>
